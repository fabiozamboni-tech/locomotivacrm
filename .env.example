# =============================================================================
# LOCOMOTIVA CRM - CONFIGURAÇÕES DE AMBIENTE & CHAVES DE API
# =============================================================================

# Chave do SerpApi (Obtenha gratuitamente em https://serpapi.com - 100 buscas/mês gratuitas)
# Utilizada para busca profunda no Google Maps, Instagram, LinkedIn, TikTok e Facebook.
# Se deixada em branco, o sistema utilizará o motor gratuito e aberto (OpenStreetMap / Overpass / BrasilAPI).
SERPAPI_API_KEY=

# Chave do Apify (Opcional - https://apify.com)
APIFY_API_KEY=

# Chaves do Lovable Cloud Gateway (Opcionais se hospedado no Lovable)
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Banco de Dados Cloud (Opcional - Se não informado, utiliza o motor persistente atômico nativo)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua-chave-anon
# DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres
